#!/bin/bash
set -euo pipefail

if [[ "${DOSTFLIX_IN_SCOPE:-}" == "1" ]]; then
  exec /usr/lib/dostflix/dostflix "$@"
fi

raw_session=$(< /proc/sys/kernel/random/uuid)
session_id=${raw_session//-/}
scope_name="dostflix-${session_id}.scope"

exec systemd-run --user --scope --quiet --unit="${scope_name}" \
  --setenv=DOSTFLIX_IN_SCOPE=1 \
  --setenv=DOSTFLIX_GUARD_SESSION="${session_id}" \
  --setenv=DOSTFLIX_GUARD_SCOPE="${scope_name}" \
  /usr/lib/dostflix/dostflix "$@"

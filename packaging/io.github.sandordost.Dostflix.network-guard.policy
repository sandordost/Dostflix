<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Dostflix</vendor>
  <vendor_url>https://github.com/sandordost/Dostflix</vendor_url>
  <action id="io.github.sandordost.Dostflix.network-guard">
    <description>Change Dostflix network protection</description>
    <message>Authentication is required to protect Dostflix network traffic</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/dostflix/dostflix-network-helper</annotate>
  </action>
</policyconfig>
